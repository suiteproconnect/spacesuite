# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare Calls (SFU) credentials (Cloudflare Pages Secrets / Env)
CLOUDFLARE_CALLS_APP_ID=""
CLOUDFLARE_CALLS_APP_SECRET=""

# Optional HMAC secret for Edge auth tokens (auto-persisted in D1 if omitted)
AUTH_SECRET=""

# Optional bootstrap administrator credentials & setup key (Cloudflare Pages Secrets)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SETUP_KEY=""

