# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Metered SFU video conferencing credentials (Cloudflare Pages Secrets / Env)
METERED_DOMAIN=""
METERED_SECRET_KEY=""

# Optional HMAC secret for Edge auth tokens (auto-persisted in D1 if omitted)
AUTH_SECRET=""

# Optional bootstrap administrator credentials & setup key (Cloudflare Pages Secrets)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SETUP_KEY=""

